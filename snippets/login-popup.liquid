<div class="modal-wrapper mfp-hide" id="login-popup">
  <div class="container new-form-design">
    <div class="row">
      
      
      
      
      
      <div class="col-md-6">
        <div class="login-modal-box-wrap">
          <h2 class="title"{% if settings.language_enable %} data-translate="customer.login.page_title"{% endif %}>{{ 'customer.login.page_title' | t }}</h2>
          {% form 'customer_login' %}
          <div class="form-list">
            <div class="fields-wrap">
              <label for="login-email"{% if settings.language_enable %} data-translate="customer.login.email"{% endif %}>{{ 'customer.login.email' | t }} <span class="required">&nbsp;*</span></label>
              <input type="email" name="customer[email]" class="input-full" id="login-email" autocapitalize="off" autocorrect="off" required />
            </div>
            <div class="fields-wrap">
              <label for="login-password"{% if settings.language_enable %} data-translate="customer.login.password"{% endif %}>{{ 'customer.login.password' | t }} <span class="required">&nbsp;*</span></label>
              <input type="password" name="customer[password]" class="input-full" id="login-password" required />
            </div>
            <div class="fields-btn">
              <button type="submit" class="btn-button"{% if settings.language_enable %} data-translate="customer.login.page_title"{% endif %}>{{ 'customer.login.page_title' | t }}</button>
              <a href="/account/login#recover" class="forget-password"{% if settings.language_enable %} data-translate="customer.login.forgot_password"{% endif %}>{{ 'customer.login.forgot_password' | t }}</a>
            </div>
          </div>
        </div>
        {% endform %}
      </div>






      <div class="col-md-6">
        <div class="login-modal-box-wrap">
          <h2 class="title"{% if settings.language_enable %} data-translate="customer.register.page_title"{% endif %}>{{ 'customer.register.page_title' | t }}</h2>

          {% form 'create_customer' %}

          <div class="form-list">
            <div class="fields-two-group">
              <div class="fields-wrap">
                <label for="first-name"{% if settings.language_enable %} data-translate="customer.register.first_name"{% endif %}>{{ 'customer.register.first_name' | t }}<span class="required">&nbsp;*</span></label>
                <input type="text" name="customer[first_name]" id="first-name" class="input-full"{% if form.first_name %} value="{{ form.first_name }}"{% endif %} autocapitalize="words" autofocus required/>
              </div>
              <div class="fields-wrap">
                <label for="last-name"{% if settings.language_enable %} data-translate="customer.register.last_name"{% endif %}>{{ 'customer.register.last_name' | t }}<span class="required">&nbsp;*</span></label>
                <input type="text" name="customer[last_name]" id="last-name" class="input-full"{% if form.last_name %} value="{{ form.last_name }}"{% endif %} autocapitalize="words" required>
              </div>
            </div>
            <div class="fields-wrap">
              <label for="register-email"{% if settings.language_enable %} data-translate="customer.login.email"{% endif %}>{{ 'customer.login.email' | t }} <span class="required">&nbsp;*</span></label>
              <input type="email" name="customer[email]" class="input-full" id="register-email" required>
            </div>
            <div class="fields-wrap">
              <label for="register-password"{% if settings.language_enable %} data-translate="customer.login.password"{% endif %}>{{ 'customer.login.password' | t }} <span class="required">&nbsp;*</span></label>
              <input type="password" name="customer[password]" class="input-full" id="register-password" required />
            </div>
            <div class="fields-btn">
              <button type="submit" class="btn-button"{% if settings.language_enable %} data-translate="customer.register.page_title"{% endif %}>{{ 'customer.register.page_title' | t }}</button>
            </div>
          </div>

        </div>
        {% endform %}
      </div>






    </div><!-- End .row -->
  </div><!-- End .container -->
</div>

<script>
  $(document).ready(() => {
    $("a[href='/account/login']").click((e) => {
      e.preventDefault();
      $.magnificPopup.open({
        items: {
          src: $('#login-popup'),
          type: 'inline'
        },
        removalDelay: 350,
        mainClass: 'mfp-smooth-fade login-popup',
        midClick: true,
        fixedBgPos: true
      });
    });
  });
</script>