{%- comment -%}
  Shows the Spin Mop Dada Judge.me reviews on the home page and the Spin Mop Dada
  product page. The Replo layouts embed a review widget bound to the Spin Mop Dada
  Starter Kit (1 review), so swap it for the Spin Mop Dada widget (hundreds of reviews).
  Lives in the theme so Replo republishes don't undo it.
{%- endcomment -%}
{%- assign jm_source_handle = 'spin-mop-dada' -%}
{%- assign jm_show = false -%}
{%- if template.name == 'index' -%}
  {%- assign jm_show = true -%}
{%- elsif template.name == 'product' and product.handle == jm_source_handle -%}
  {%- assign jm_show = true -%}
{%- endif -%}
{%- if jm_show -%}
  {%- assign jm_product = all_products[jm_source_handle] -%}
  {%- if jm_product != blank -%}
    {%- if template.name == 'index' -%}
      <style>
        @media (min-width: 1025px) {
          #replo-fullpage-element #judgeme_product_reviews {
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
          }
        }
      </style>
    {%- endif -%}
    <template id="jm-dada-reviews">
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ jm_product.title | escape }}" data-id="{{ jm_product.id }}">
        {{ jm_product.metafields.judgeme.widget }}
      </div>
    </template>
    <script>
      (function () {
        var tpl = document.getElementById('jm-dada-reviews');
        var target = document.querySelector('#replo-fullpage-element #judgeme_product_reviews');
        if (!tpl || !target) return;
        target.parentNode.replaceChild(tpl.content.cloneNode(true), target);
      })();
    </script>
  {%- endif -%}
{%- endif -%}
