            <div class="col">
                <div class="card-wrap">
                    <div class="card-view">
                        <a href="/collections/spin-mop-dada" title="Browse our Spin Mop Dada collection" class="collections-image google-drive-opener">
                            <img src="{{ 'category_3.jpg' | asset_url }}" alt="Spin Mop Dada" class="lazypreload lazyloaded">
                        </a>
                        <div class="card-body">
                            <h3>Spin Mop dada</h3>
                            <p>2 Products</p>
                            <a href="/collections/spin-mop-dada" title="Browse our Spin Mop Dada collection" class="google-drive-opener">View Product</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card-wrap">
                    <div class="card-view">
                        <a href="/collections/commercial-mop-system" title="Browse our Spin Mop Papa collection" class="collections-image google-drive-opener">
                            <img src="{{ 'category_1.jpg' | asset_url }}" alt="Spin Mop Papa" class="lazypreload lazyloaded">
                        </a>
                        <div class="card-body">
                            <h3>Spin Mop Papa</h3>
                            <p>3 Products</p>
                            <a href="/collections/commercial-mop-system" title="Browse our Spin Mop Papa collection" class="google-drive-opener">View Product</a>
                        </div>
                    </div>
                </div>
            </div>
              
        
            {% comment %}
                For onboarding new users to your theme, we add some default collections and onboarding tutorials to help populate their store
            {% endcomment %}
        
            {% if isEmpty %}
                {% unless emptyState %}
                {{ 'themestyle.css' | global_asset_url | stylesheet_tag }}
                {% assign emptyState = true %}
                {% endunless %}
        
                {% include 'onboarding-featured-collections' %}
            {% endif %}
        
            </div>
        </div>
    </div>

    

    <div class="section-block">
        <div class="container">
            <div class="inline-components-center">
                <h2>Looking to Buy a Spin Mop in Ireland?</h2>
                <p>Click the interactive map below for details on your nearest retailer and pick up a René Spin Mop on your next visit!</p>
            </div>
        </div>
        <div class="google-maps-spinmop">
            <div class="google-maps-wrap">
                <iframe src="https://www.google.com/maps/d/embed?mid=1F6gkDslXXijzz9G8lGo9uphIlc9DafBu" width="100%" frameBorder="0" scrolling="no" ></iframe>
                <!-- style='pointer-events:none;' -->
            </div>
        </div>
    </div>

    
    <div class="section-block" id="my-about">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="h-about-img">
                        <img src="{{ 'about_thumbnail.png' | asset_url }}" class="img-fluid" alt=""/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="h-about-content">
                        <h2>About Us</h2>
                        <p>René Innovations is Ireland & the UK’s leading supplier of innovative cleaning products, primarily the world-famous Spin Mop range. Originally established as Shop4Choice in 2011 by René, we've been successfully developing innovative home products ever since.</p>
                        <blockquote>Quality, Value and Convenience Assured</blockquote>
                        <p>Our team works hard sourcing, developing & launching innovative new cleaning products to improve consumer lifestyles and business efficiencies throughout Ireland and internationally.</p>
                        <p>We are also focused on developing retail partnerships for our high-demand mop products. We introduced the original Spin Mop product to the Irish market which has been continuously redeveloped and redesigned through constant customer feedback.</p>
                        <p>These vital, continual improvements have given Spin Mop instant brand recognition, with a prestigious place in the Irish cleaning product market and beyond, and with a range of new and exciting products in our portfolio, we aim to delight for many years to come!</p>
                        <a class="btn btn-primary" href="/pages/about">Meet the Folks Behind the Mop!</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="section-block ">
        <div class="container">

            <div class="section-heading text-center">
                <h2 class="text-uppercase">Reviews</h2>
                <p>See what our happy customers have to say</p>
            </div>

            <!-- <div class="testimonial-wrap"> -->
                <!-- {% comment %}
                {% section 'testimonials' %}
                {% endcomment %} -->
                
            <!-- </div> -->
            <div class="testimonial-wrapp">
                {% include 'judgeme_widgets', widget_type: 'judgeme_featured_carousel', concierge_install: true, auto_install: true %}
            </div>

        </div>
    </div>

    <div class="section-block">
        <div class="container">

            <div class="section-heading text-center">
                <h2 class="text-uppercase">Rene’s Blog</h2>
                {% comment %}
                {{ 'homepage.sections.news_title' | t }}
                {% endcomment %}
                <p>Tips, tricks and useful info from the Rene team</p>
            </div>

            <div class="row">
            {% for article in blogs['news'].articles limit:3 %}
        
                <div class="col-md-4">
                    <div class="card-wrap">
                        <div class="card-view">
                            <a href="{{ article.url }}" class="featured-thumbnail">
                                {% if article.image %}
                                {{ article.image.src | img_url: 'large' | img_tag: article.title }}
                                {% else %}
                                {{ article.first.featured_image | img_url: 'large' | img_tag: article.title }}
                                {% endif %}
                            </a>
                            <div class="card-body">
                                <time class="card-post-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#30A3D5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <span>{{ article.published_at | date: format: 'month_day_year' }}</span>
                                </time>
                                <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
                                {% comment %}
                                    Add a surrounding div with class 'rte' to anything that will come from the rich text editor.
                                    Since this is just a listing page, you can either use the excerpt or truncate the full article.
                                {% endcomment %}
                                <div class="rte">
                                    {% if article.excerpt.size > 0 %}
                                    {{ article.excerpt }}
                                    {% else %}
                                    <p>{{ article.content | strip_html | truncatewords: 20 }}</p>
                                    {% endif %}
                                </div>
                                <a href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a>
                            </div>
                        </div>
                    </div>
                </div>
        
            {% endfor %}
            </div>

            <div class="text-center mt-60">
                <a href="/blogs/news" class="btn btn-primary">View All</a>
            </div>

        </div>
    </div>

    {% comment %}
        <div class="section-block">
            {{ content_for_index }}
        </div>
    {% endcomment %}

</div>


  



