<!-- /templates/index.liquid -->
<div class="wrapper">

    <div class="hero-block">
        <div class="hero-slider">

            <div class="hero-item">
                <div class="container">
                    <div class="hero-content">
                        <div class="hero-box">
                            <h2>Spin Mop Dada</h2>
                            <h4>Efficient. Durable. Hygienic.</h4>
                            <p>Rene’s brilliant cleaning innovations help homeowners and businesses save time, money and effort.</p>
                        </div>
                        <a class="btn btn-primary on-decstop" href="/collections/products">shop Cutting-Edge Cleaning Solutions</a>
                        <a class="btn btn-primary on-mobile" href="/collections/products">Shop Now</a>
                    </div>
                </div>
                <img src="{{ 'banner--spin-mop-dada.png' | asset_url }}" class="img-fluid" alt=""/>
            </div>

        </div>
    </div>


    <div class="section-block">
        <div class="container">
            <div class="row flex-row-reverse align-items-center">

                <div class="col-md-6">
                    <div class="inline-components-img">
                        <img src="{{ 'dada_4.jpg' | asset_url }}" class="img-fluid" alt=""/>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="inline-components-content">
                        <h3>Spin Mop Dada</h3>
                        <p>Our product utilises powerful centrifugal force to effortlessly spin the mop dry in seconds, no more wet floors! While the built-in washing agitator spins the mop head clean every time.</p>
                        <a class="btn btn-primary" href="/products/spin-mop-dada">Shop Spin Mop Dada Now! </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <div class="section-block">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-6">
                    <div class="inline-components-img">
                        <img src="{{ 'rene_toilet_brush_handle.jpg' | asset_url }}" class="img-fluid" alt=""/>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="inline-components-content">
                        <h3>3 In 1 Flexible Toilet Brush</h3>
                        <p>Designed with high-quality materials to be durable, hygienic and long lifespan. Unlike traditional toilet brushes, the brush head is made out of non-scratch silicone that makes it easy to clean, plus it won't harbour nasty smells.</p>
                        <a class="btn btn-primary" href="/products/3-in-1-flexible-toilet-brush">shop Toilet Brush now</a>
                    </div>
                </div>

            </div>
        </div>
    </div>

     <div class="section-block">
        <div class="container">
            <div class="row flex-row-reverse align-items-center">

                <div class="col-md-6">
                    <div class="inline-components-img">
                        <img src="{{ 'dustpan04.jpg' | asset_url }}" class="img-fluid" alt=""/>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="inline-components-content">
                        <h3>One-sweep Dustpan</h3>
                        <p>Designed to make everyday cleaning simple, fast, and effective. The One-sweep Dustpan by René Innovations captures up to 99% of dirt in one sweep.</p>
                        <a class="btn btn-primary" href="/collections/one-sweep-dustpan">Shop One-sweep Dustpan Now! </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="section-block with-bg">
        <div class="container">
            <div class="row">

                <div class="col-md-4">
                    <div class="custom-support-box">
                        <div class="custom-support-icon">
                            <img src="{{ 'icon_brilliant.svg' | asset_url }}" alt=""/>
                        </div>
                        <h3>BRILLIANT<span>INNOVATIONS</span></h3>
                        <p>To Save Time, Money & Effort</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="custom-support-box">
                        <div class="custom-support-icon">
                            <img src="{{ 'icon_high_quality.svg' | asset_url }}" alt=""/>
                        </div>
                        <h3>HIGH QUALITY<span>PRODUCTS</span></h3>
                        <p>Domestic & Professional use</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="custom-support-box">
                        <div class="custom-support-icon">
                            <img src="{{ 'icon_customer.svg' | asset_url }}" alt=""/>
                        </div>
                        <h3>CUSTOMER<span>SUPPORT</span></h3>
                        <p>Spare Parts & Warranty</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="section-block featuerd-block">
        <div class="container">

            <div class="section-heading text-center">
                <h2 class="text-uppercase">{{ 'homepage.sections.featured_title' | t }}</h2>
                <p>Browse our cutting-edge cleaning products</p>
            </div>

