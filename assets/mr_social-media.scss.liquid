
/* Created by Mirelle Nascimento */

.mr-social-icons__header{
    width: 70%;
    margin: 40px auto 40px auto;
}

.mr-social-icons__container{
  width: 100%;
}
.mr-social-posts__container{
  width: 50%;
    margin: 40px auto;
}
.mr-social-posts__item{
   margin: 20px;
}


.mr-social-icons__item{
  display:flex;
  align-items: center;
    width: 70%;
    margin: auto;
    border: 1px solid lightgrey;
    padding: 20px;
    margin-top: 15px;
    border-radius: 15px;
}

.mr-social-icons__item-circle{
  border-radius: 50%;
  height: 70px;
  width:70px;
  background-color: #30a3d5;
  display:flex;
  align-items: center;
  justify-items: center;
  margin-right: 20px;
}

.mr-social-icons__icon{
  font-size: 40px;
  padding-left: 6px;
  padding-top: 3px;
  color: white!important;
}

.mr-social-icons__text-block{
  height: 70px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.mr-social-icons__text1{
  margin:0!important;
  font-size: 22px!important;
  color: black!important;
}
.mr-social-icons__text2{
  margin:0!important;
  color:grey!important;
}
