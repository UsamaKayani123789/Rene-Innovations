// STOCK STYLE
.stocklist-head{
    background-color: #EAF6FB;
    padding: 20px 0px;
    
    .stocklist-search{
        display: flex;
        justify-content: space-between;
        margin: 0px -15px;

        .stock-col{
            padding: 0px 15px;
            flex: 1 0;
            &.col-auto{
                flex: 0 1 auto;
            }
        }
    }
}

.form-control{
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 2px;
    width: 100%;
    font-family: $body_font;
    font-size: 18px;
    line-height: 22px;
    color: $font_color;
    height: auto;
    padding: 20px;
}

.stocklist-item{
    padding: 15px 0px;
    &:nth-child(even) {
        background: rgba($color: #30A3D5, $alpha: 0.1);
    }
    &:nth-child(odd) {
        background: #ffffff;
    }
}

.stocklist-box{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0px -15px;

    .stocklist-title{
        flex: 1 0 35%;
        max-width: 35%;
        padding: 15px;
        h3{
            font-weight: 500;
            font-size: 20px;
            line-height: 28px;
            text-transform: uppercase;
            color: $black_color;
            margin-bottom: 0px;
        }
        h4{
            font-weight: 400;
            font-size: 16px;
            line-height: 24px;
            margin-bottom: 0px;
        }
    }
    .stocklist-address{
        flex: 1 0 35%;
        max-width: 35%;
        padding: 15px;
        h5{
            font-family: $body_font;
            font-size: $base_font_size;
            line-height: 22px;
            text-transform: uppercase;
            color: $primary_color;
            margin-bottom: 10px;
        }
        p{
            font-family: $body_font;
            font-size: $base_font_size;
            line-height: 30px;
            color: $black_color;
            margin-bottom: 0px;

            a{
                color: $black_color;
            }
        }
    }
    .stocklist-info{
        flex: 1 0 30%;
        max-width: 30%;
        padding: 15px;
        p{
            font-family: $body_font;
            font-size: $base_font_size;
            line-height: 20px;
            color: $black_color;
            margin:10px 0px;
            span{
                font-weight: 700;
                color: $primary_color;
                margin-right: 6px;
            }
            a{
                color: $black_color;
            }
        }
    }
}


// FOOTER STYLE
.footer-wrapper {

