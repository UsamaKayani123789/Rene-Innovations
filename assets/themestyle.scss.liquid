            align-items: center;
            width: 220px;

            .icon-phone-1{
                color: $primary_color;    
                font-size: 24px;
                margin-right: 5px;
            }

            .estimate-label{
                font-family: $body_font;
                font-weight: 500;
                font-size: 12px;
                line-height: 14px;
