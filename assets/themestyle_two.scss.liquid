$primary_color: #30A3D5;
$font_color: #333333;
$black_color: #000000;
$bottom_space_hack: 48px;
$base_font_size: 16px;
$body_font: 'Roboto', sans-serif;
$title_font: 'Montserrat', sans-serif;
@media screen and (max-width:767px){
    $base_font_size: 14px;
}
// ::-moz-selection {
//     background-color: lighten($primary-color, 10%);
// }  
// ::selection {
//     background-color: lighten($primary-color, 10%);
// }




.header-container .header{
    padding-top: 8px;
}
// Inner Page Wrapper
.inner-page-wrapper{
    margin-top: 120px;
    margin-bottom: $bottom_space_hack;
    font-family: $body_font;
    @media screen and (max-width:767px){
        margin-top: 60px;
        margin-bottom: 30px;
    }
}
.page-data-wrap{
    margin-bottom: $bottom_space_hack;
    @media screen and (max-width:767px){
        margin-bottom: 30px;
    }
}



// Basics
[type=reset],
[type=submit],
button,
html [type=button]{
    background-color: #30A3D5;
    border-color: transparent;
    color: #fff;
    line-height: 1.5;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 40px;
}





// Main Heading
.inner-page-wrapper{
    h1{
        font-size: 35px;
        font-family: $title_font;
        font-weight: 500;
        color: $primary_color;
        text-transform: uppercase;
        margin-bottom: 15px;
        line-height: 1;
        @media screen and (max-width:767px){
            font-size: 28px;
        }
    }
    p{
        font-size: 18px;
        line-height: 1.7;
        margin-bottom: 20px;
        color: $font_color;
        a{
            color: $primary_color;
            &:hover,
            &:focus,
            &:active{
                color: $font_color;
                text-decoration: underline;
            }
        }
    }
}





// Sub Heading and list
.inner-page-wrapper{
    h5,
    .BodyBoldRed,
    .checkout-title{
        font-size: 30px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        margin-bottom: 20px;
        text-transform: uppercase;
        color: $black_color;
        @media screen and (max-width:767px){
            margin-bottom: 10px;
            font-size: 24px;
            line-height: normal;
        }
    }
}
.inner-page-wrapper{
    ol{
      li{
        font-size: 18px;
        line-height: 1.7;
        margin-bottom: 15px;
        color: $font_color;
        padding-left: 20px;
        position: relative;
        &::before{
            content: '';
            background-image: url('../assets/list-right-arrow.svg');
            width: 7px;
            height: 12px;
            position: absolute;
            left: 0;
            top: 8px;
        }
      }  
    }
}





// Blue table
.inner-page-wrapper{
    table{
        background-color: $primary_color;
        color: #ffffff;
        width: 100%;
        display: table;
        border: none;
    }
    table{
        td{
            padding: 15px;
            border-bottom: 1px solid #ffffff40;
            border-left: 0;
            border-right: 0;
            border-top: 0;
            @media screen and (max-width:767px){
                padding: 10px;
            }
        }
    }
    table{
        thead{
            td{
                font-family: 'Montserrat', sans-serif;
                text-transform: uppercase;
                font-size: 22px;
                border-bottom: 0;
                padding-top: 40px;
                @media screen and (max-width:767px){
                    padding-top: 20px;
                    font-size: 18px;
                    font-weight: 500;
                }
            }
        }
    }
}





// Form
.new-form-design{
    margin-top: 120px;
    @media screen and (max-width:1024px){
        margin-top: 80px;
    }
    @media screen and (max-width:767px){
        margin-top: 40px;
    }
}
.new-form-design .contact-form,
.new-box-design{
    padding: 0;
}


.new-form-design{
    .contact-form{
        .contact-title{
            font-size: 35px;
            text-transform: uppercase;
            margin-bottom: 35px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 500;
            b{
                font-weight: 500;
            }
            @media screen and (max-width:1024px){
                margin-bottom: 20px;
                font-size: 28px;
            }
            @media screen and (max-width:767px){
                margin-bottom: 16px;
                font-size: 22px;
            }
        }
    }
}


.new-form-design{
    .form-list{
        label{
            font-size: 13px;
            text-transform: uppercase;
            color: $font_color;
            float: none;
            margin-bottom: 0;
            em{
                color: #ff0000;
            }
        }
        .input-full{
            height: 41px;
            border-radius: 0;
            border: 0;
            border-bottom: 1px solid #00000010;
            box-shadow: none;
            padding: 4px 0 4px 0;
            margin: 0;
            font-family: $body_font;
            color: $font_color;
            font-size: 14px;
            &:focus,
            &:active{
                border-bottom-color: $black_color;
            }
        }
        textarea.input-full{
            min-height: 115px;
            line-height: normal;
        }
        .fields-btn{
            margin-top: 50px;
            .btn-button{
                font-family: 'Roboto', sans-serif;
                background-color: $primary_color;
                border-radius: 50px;
                line-height: 1;
                text-transform: uppercase;
                padding: 18px 40px;
                font-size: 18px;
                font-weight: 500;
                &:focus{
                    outline: dotted;
                    outline-color: #000;
                    outline-width: 1px;
                }
                @media screen and (max-width:540px){
                    padding: 15px 35px;
                    font-size: 16px;
                }
            }
        }
    }
}
.login-button{
    .btn-button{
        font-family: 'Roboto', sans-serif;
        background-color: $primary_color;
        border-radius: 50px;
        line-height: 1;
        text-transform: uppercase;
        padding: 18px 40px;
        font-size: 18px;
        font-weight: 500;
        &:focus{
            outline: dotted;
            outline-color: #000;
            outline-width: 1px;
        }
        @media screen and (max-width:540px){
            padding: 15px 35px;
            font-size: 16px;
        }
    }
}
.new-form-design{
    .form-list .fields-wrap{
        margin-bottom: 30px;
        &:last-of-type{
            margin-bottom: 0;
        }
        @media screen and (max-width:540px){
            margin-bottom: 20px;
        }
    }
}
.new-form-design{
    .form-list{
        .fields-two-group{
            display: flex;
            margin: 0 -15px 30px -15px;
            > div.fields-wrap{
                padding: 0 15px;
                margin: 0;
                max-width: 50%;
                width: 100%;
                @media screen and (max-width:540px){
                    padding: 0;
                    margin-bottom: 20px;
                    max-width: 100%;
                }
            }
            @media screen and (max-width:540px){
                display: block;
                margin: 0;
            }
        }
    }
}




.new-box-design{
    background-color: $primary_color;
    padding: 40px;
    display: inline-block;
    width: 100%;
    vertical-align: top;
    clear: both;
    h1{
        font-size: 35px;
        text-transform: uppercase;
        margin-bottom: 40px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        color: #ffffff;
        line-height: 1.2;
        span{
            color: #ffffff!important;
        }
        @media screen and (max-width:1024px){
            margin-bottom: 20px;
            font-size: 28px;
        }
        @media screen and (max-width:767px){
            margin-bottom: 16px;
            font-size: 22px;
        }
    }
    i{
        background-color: transparent;
        color: #ffffff;
        border: 1px solid #ffffff;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    p, a{
        color: #ffffff;
        b{
            font-weight: 400;
        }
    }
    div.row{
        margin-bottom: 20px;
        &:last-of-type{
            margin-bottom: 0;
        }
        @media screen and (max-width:1024px){
            margin-bottom: 10px;
        }
    }
    @media screen and (max-width:1024px){
        padding: 20px;
    }
    @media screen and (max-width:767px){
        margin-top: 30px;
    }
}
















.reg-warranty-form{
    .textrea-box{
        min-height: 115px;
    }
}
.reg-warranty-text{
    margin-bottom: 80px;
    font-family: 'Roboto', sans-serif;
    p{
        color: $font_color;
        font-size: 16px;
        margin-bottom: 20px;
        &:last-of-type{
            margin-bottom: 0;
        }
        a{
            text-decoration: underline;
            color: $font_color;
            &:hover{
                color: $primary_color;
                text-decoration: none;
            }
            &:active,
            &:focus{
                color: $primary_color;
            }
        }
    }
}






.main-container .account-login,
.main-container .account-create{
    padding-top: 0;
}
.main-container{
    .login_content{
        padding: 0;
        border: 0;
        box-shadow: 0 0 black;
    }
}
.login-left{
    .page-title{
        margin-bottom: 65px;
        @media screen and (max-width:540px){
            margin-bottom: 40px;
            text-align: center;
        }
    }
}
.main-container .login_content .login-left{
    .login-button{
        margin-top: 28px;
        .buttons-set{
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 0;
            padding: 0;
            @media screen and (max-width:540px){
                display: block;
                text-align: center;
            }
            a{
                font-size: 16px;
                color: $font_color;
                font-family: 'Roboto', sans-serif;
                line-height: 1;
                float: none;
                @media screen and (max-width:540px){
                    display: inline-block;
                    width: 100%;
                    margin-bottom: 16px;
                }
            }
            p{
                margin: 0;
            }
            .btn-button{
                float: none;
            }
        }
    }
}



.main-container .login_content .login-left{
    .page-title{
        h2{
            font-size: 24px;
            font-weight: 500;
            margin: 0 0 12px 0;
            line-height: 1;
        }
        p{
            font-size: $base_font_size;
            font-family: $body_font;
            margin: 0;
        }
    }
}
.main-container .login_content .login-right{
    @media screen and (max-width:767px){
        margin-top: 30px;
    }
    .btn-button{
        float: none;
        margin: 30px 0 0 0;
    }
    h2{
        font-size: 24px;
        font-weight: 500;
        margin-bottom: 12px;
    }
    p{
        font-size: $base_font_size;
        font-family: $body_font;
        color: $font_color;
        margin: 0;
        line-height: 1.7;
    }
}










div#rc_login{
    margin: 50px 0 0 0;
    text-align: center;
    h5{
        text-transform: uppercase;
        font-size: 20px;
        margin-bottom: 15px;
    }
    p{
        margin: 0;
        line-height: 1;
        font-size: $base_font_size;
        font-family: $body_font;
        a{
            color: $primary_color;
            &:hover{
                color: $font_color;
                text-decoration: underline;
            }
        }
    }
}





.login-popup{
    .container{
        padding: 38px;
        @media screen and (max-width:767px){
            padding: 20px 20px 0 20px;
        }
    }
    .new-form-design{
        margin: 0;
        .form-list{
            .fields-btn{
                margin-top: 0;
                .forget-password{
                    color: $font_color;
                    font-family: $body_font;
                    display: inline-block;
                    width: 100%;
                    margin-top: 20px;
                    font-size: 14px;
                    text-decoration: underline;
                    &:hover,
                    &:focus{
                        text-decoration: none;
                    }
                    &:active{
                        color: $primary_color;
                    }
                }
            }
        }
    }
}
.login-modal-box-wrap{
    h2.title{
        color: $black_color;
        font-size: 22px;
        line-height: 1;
        font-weight: 500;
        margin-bottom: 20px;
    }
    @media screen and (max-width:767px){
        margin-bottom: 20px;
    }
}
.mfp-close-btn-in .mfp-close{
    color: $black_color;
    background-color: #00000015;
    border-radius: 0;
    font-weight: 300;
}








// Faq's Page
.cd-faq{
    .cd-faq-group{
        li{
            border-bottom: 1px solid #00000010;
            padding: 30px 0;
            @media screen and (max-width:767px){
                padding-top: 15px;
                padding-bottom: 15px;
            }
            > b{
                font-family: $title_font;
                color: $font_color;
                font-size: 22px;
                text-transform: uppercase;
                font-weight: 400;
                line-height: 1.5;
                @media screen and (max-width:767px){
                    font-size: 18px;
                }
            }
            .cd-faq-content{
                p{
                    margin-bottom: 15px;
                    @media screen and (max-width:767px){
                        margin-bottom: 10px;
                        font-size: 16px;
                    }
                    &:first-of-type{
                        margin-top: 10px;
                    }
                    &:last-of-type{
                        margin-bottom: 0;
                    }
                    a{
                        color: $primary_color;
                    }
                }
            }
        }
    }
}







// Footer
.footer_2 .input-group .btn-button{
    border: none;
    box-shadow: none;
}
.footer-wrapper .social-icons a{
    border: 1px solid #fff;
    border-radius: 50%;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    transition: all ease 0.5s 0s;
    &:focus,
    &:hover,
    &:active{
        background-color: #ffffff10;
        border-color: #ffffff10;
    }
}






// Cart Popup
.widget-design-1 .cart-wrapper .cart-content p.no-items-in-cart{
    font-family: $title_font;
    line-height: 1.6;
    color: $font_color;
}
.header-container{
    .mini-cart{
        .cart-wrapper{
            border-radius: 0;
            box-shadow: 0 10px 50px rgba(0,0,0,0.1);
            width: 450px;
            color: #333333;
            border: none;
            &::before{
                top: -20px;
                border-bottom-color: #ffffff;
            }
        }
    }
}
.widget-design-1 .cart-wrapper .cart-content ul li.item-cart{
    .product-image{
        width: 75px;
        height: 65px;
        border: 1px solid #00000010;
    }
    .product-details{
        a{
            color: $font_color;
            font-family: $body_font;
        }
        .product-name{
            margin: 0 0 10px 0;
            padding-right: 0;
            font-size: 14px;
        }
    }
    .items{
        .price{
            color: $font_color;
            font-family: $body_font;
        }
        .amount{
            font-weight: 500;
        }
    }
}
.mini-cart{
    .widget-design-1 .cart-wrapper .cart-checkout p.subtotal{
        margin-bottom: 0;
        padding: 30px 20px 0px 20px;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
        text-transform: uppercase;
        label{
            color: $black_color;
            font-weight: 400;
        }
    }
    .widget-design-1 .cart-wrapper .cart-checkout .actions{
        margin: 30px 30px 30px 30px;
        line-height: normal;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .widget-design-1 .cart-wrapper .cart-checkout .actions a{
        width: 100%;
        padding: 18px 22px;
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
        max-width: 48%;
        font-size: 18px;
    }
}


.box-popup .box-inner .action .action-content{
    margin: 0;
}
.box-popup .box-inner .action .action-content .btn-button,
.box-popup .box-inner .action .action-content a.btn-button{
    width: 100%;
    padding: 18px 22px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    max-width: 100%;
    font-size: 18px;
    min-width: auto;
    margin: 0 0 10px 0;
    border: none;
}
.box-popup{
    border-radius: 0;
    border-top: 0;
    box-shadow: 0 10px 50px rgba(0,0,0,0.1);
}



#collection-main{
    margin-top: 70px;
}
.toolbar{
    margin-bottom: 20px;
}
.product-main{
    .collection-main-banner{
        font-family: $title_font;
        text-align: center;
        font-size: 20px;
        padding: 50px 0 0 0;
        line-height: 1.6;
        span{
            color: $primary_color;
        }
    }
}








// Stocklist
.inner-stockist {
    margin-bottom: 33px;
    display: inline-block;
    width: 100%;
    vertical-align: top;
    margin: 0 0 10px 0;
    background-color: #30A3D510;
    padding: 20px 0;
}










.template-blog .block .blogs-items ul li a,
.template-article .block .blogs-items ul li a{
    font-size: 16px;
    line-height: 1.5 !important;
}
.template-blog .block-main-canvas .block-title h3,
.template-blog .block-main-canvas .block-title h3,
.template-article .block-main-canvas .block-title,
.template-article .block-main-canvas .block-title{
    font-size: 20px;
    font-weight: 700;
}




.post-block{
    .post-options{
        text-transform: uppercase;
    }
    .post-heading{
        margin: 10px 0 12px 0;
        h3{
            font-family: $body_font;
            font-size: 20px;
            font-weight: normal;
            margin: 0;
        }
    }
}
.post-block{
    .post-more{
        margin-top: 35px;
        color: $primary_color;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        width: 100%;
        vertical-align: top;
    }
    .post-excerpt{
        font-size: 16px;
        margin-bottom: 0;
        line-height: 1.6;
    }
    .post-img-block{
        margin-bottom: 22px;
        .featured-thumbnail{
            max-height: 250px;
            padding: 0;
            img{
                position: static;
                width: 100%;
                bottom: auto;
                top: auto;
                left: auto;
            }
        }
    }
}

.template-article{
    .post-block{
        .post-img-block{
            .featured-thumbnail{
                max-height: 100%;
                width: 100%;
            }
        }
    }
}
.post-tools{
    padding: 22px 35px;
    margin: 50px 0;
    .at-icon-wrapper{
        background-color: #ffffff;
    }
}
.post-comment{
    .form-list{
        margin-top: 50px;
    }
}



.content-contact.new-box-design{
    h1{
        font-size: 35px;
    }
}
.content-contact.new-box-design{
    ul{
        li{
            margin-bottom: 20px;
            &:last-child{
                margin-bottom: 0;
            }
        }
    }
}
.contact-list{
    display: flex;
    align-items: center;
    .contact-icon{
        margin-right: 20px;
    }
}
.content-contact.new-box-design{
    .contact-list{
        p{
            margin-bottom: 4px;
            &:last-of-type{
                padding-bottom: 0;
                margin-bottom: 0;
            }
        }
    }
}



.bluefoot-accordion-link{
    color: $black_color;
    text-transform: uppercase;
    font-size: 30px;
    span{
        color: $black_color;
    }
}
.hero-item{
    .hero-content{
        .on-mobile {
            margin-left: 20px;
            display: none;
        }    
    }
}

#whas-ap-fl-b {
    left: 15px;
    right: auto !important;
}

.qikify-stickycart-app{
    img {
        opacity: 1;
    }
    .qsb-product {
        padding-left: 80px;
    }
} 
.new-form-design {
    margin-top: 120px;
    margin-bottom: 120px;
}
.product-view .product-options-bottom .add-to-cart-box .actions .add-to-links {
    display: none;
}
.product-view .addthis_toolbox {
    display: none;
}
img.img-fluid.image_height_width-set {
    max-height: 670px;
    margin: auto;
    display: block;
}
.searchform {
    input[type=text] {
        padding: 0 50px 0 15px;
    }
}
// Responsive
@media only screen and (min-width: 992px) and (max-width: 1200px){
    .container {
        max-width: 1020px;
    }
}

@media only screen and (max-width: 1200px) {
    .main-container .checkout-cart .cart-table tbody tr td.product-qty{
        input{
            width: 100% !important;
            max-width: 100%;
            margin: 0;
            border: 1px solid #00000010;
            border-top: transparent;
            border-bottom: transparent;
        }
        .items,
        .items.increase{
            width: 100%;
            border: 1px solid #00000010;
        }
    }
    .header-container.sticky-header .main-nav ul.top-navigation>li>a{
        padding: 10px 12px;
    }
}
@media only screen and (max-width: 1024px) {
    .btn{
        font-size: 16px;
        padding: 14px 34px;
    }
    .hero-block{
        margin-bottom: 30px;
    }
    .hero-item{
        .hero-content{
            left: 0px;
            width: 100%;
            .hero-box{
                padding: 20px;
                margin-bottom: 20px;
                h2{
                    font-size: 38px;
                }
                h4{
                    padding: 5px 10px 5px 24px;
                    font-size: 20px;
                    margin-left: -20px;
                }
                p{
                    font-size: 16px;
                }
                @media only screen and (max-width: 767px){
                    background-color: rgba(255, 255, 255, 0.45);
                }
            }
            
        }
    }
    .section-block{
        padding-top: 30px;
        padding-bottom: 30px;
    }
    .h-about-content{
        h2{
            font-size: 48px;
        }
        p{
            font-size: 16px;
            margin-bottom: 20px;
        }
        blockquote{
            padding: 20px;
            font-size: 16px;
            margin-bottom: 18px;
        }
    }
    .section-block.with-bg{
        margin: 30px 0;
    }
    .custom-support-box{
        .custom-support-icon{
            margin-bottom: 12px;
